create database equipamento;
use equipamento;
create table tbl_equipamentos(
  id int primary key not null, 
  nome varcher(50) not null,
  descricao varchar(50) not null, 
  quantidade int(10) not null),
  marca varcher(50) not null, 
  sala int (10) not null, 
  estadoConservasao varchar(50) not null, 
  patrimonio varchar(50) not null
  );
